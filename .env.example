# Backend (all optional; defaults shown). Never commit a real .env file.
# Comma-separated list of frontend origins allowed to call the API.
FRAUDLENS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
FRAUDLENS_MODELS_DIR=models
FRAUDLENS_MAX_BODY_BYTES=1048576
FRAUDLENS_MAX_BATCH_ROWS=1000
FRAUDLENS_LOG_LEVEL=info
